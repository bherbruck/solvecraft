ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('PC-07 ellipse canonicalization witness'),'2;1');
FILE_NAME('pc07-ellipse-canonicalization.p21','2026-08-16T00:00:00',('cadmpeg'),('cadmpeg'),'cadmpeg','cadmpeg','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#2=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#3=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#2)) REPRESENTATION_CONTEXT('model','3D'));
#4=CARTESIAN_POINT('',(0.,0.,0.));
#5=DIRECTION('',(0.,0.,1.));
#6=DIRECTION('',(1.,0.,0.));
#7=DIRECTION('',(0.,1.,0.));
#8=AXIS2_PLACEMENT_3D('',#4,#5,#6);
#9=ELLIPSE('reversed semiaxes',#8,2.,6.);
#10=ELLIPSE('ordered semiaxes',#8,6.,2.);
#11=CARTESIAN_POINT('',(2.,0.,0.));
#12=CARTESIAN_POINT('',(0.,6.,0.));
#13=TRIMMED_CURVE('numeric reversed ellipse',#9,(PARAMETER_VALUE(0.)),(PARAMETER_VALUE(1.5707963267948966)),.T.,.PARAMETER.);
#14=TRIMMED_CURVE('Cartesian reversed ellipse',#9,(#11),(#12),.T.,.CARTESIAN.);
#15=CARTESIAN_POINT('',(10.,0.,0.));
#16=CARTESIAN_TRANSFORMATION_OPERATOR_3D('',#6,#7,#15,1.,#5);
#17=CURVE_REPLICA('reversed ellipse replica',#9,#16);
#18=TRIMMED_CURVE('nested reversed ellipse',#13,(PARAMETER_VALUE(0.)),(PARAMETER_VALUE(1.5707963267948966)),.T.,.PARAMETER.);
#19=OFFSET_CURVE_3D('reversed ellipse offset',#9,1.,.F.,#5);
#20=TRIMMED_CURVE('nested reversed ellipse offset',#19,(PARAMETER_VALUE(0.)),(PARAMETER_VALUE(1.5707963267948966)),.T.,.PARAMETER.);
#21=GEOMETRIC_CURVE_SET('ellipse canonicalization',(#9,#10,#13,#14,#17,#18,#19,#20));
#22=SHAPE_REPRESENTATION('ellipse canonicalization',(#21),#3);
ENDSEC;
END-ISO-10303-21;

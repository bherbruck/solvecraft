ENDSEC;
DATA;
#1=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#2=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#10)) REPRESENTATION_CONTEXT('model','3D'));
#3=CARTESIAN_POINT('',(0.,0.,0.));
#4=DIRECTION('',(0.,0.,1.));
#5=DIRECTION('',(1.,0.,0.));
#6=AXIS2_PLACEMENT_3D('',#3,#4,#5);
#7=TOROIDAL_SURFACE('',#6,3.,1.);
#8=RECTANGULAR_TRIMMED_SURFACE('forward-u-forward-v',#7,5.5,.5,.5,4.5,.T.,.T.);
#9=RECTANGULAR_TRIMMED_SURFACE('forward-u-reverse-v',#7,5.5,.5,.5,4.5,.T.,.F.);

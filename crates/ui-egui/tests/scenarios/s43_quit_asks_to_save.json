[
  {"note": "Issue #33: quitting with unsaved changes asks \"Save changes to <name>?\"; Cancel stays open."},
  {"call": "engine.execute", "params": {"command": "solid.box", "params": {"length": 20, "width": 10, "height": 5}}},
  {"call": "ui.window", "params": {"action": "close"}},
  {"expect": {"shown": "Don't Save", "quitting": true, "quit_requested": false}},
  {"widget": "Cancel"},
  {"expect": {"not_shown": "Don't Save", "quitting": false, "quit_requested": false, "bodies": 1}},
  {"note": "The File menu's Quit asks the same; Esc answers Cancel."},
  {"call": "app.quit"},
  {"expect": {"shown": "Don't Save", "quit_requested": false}},
  {"key": "Escape"},
  {"expect": {"not_shown": "Don't Save", "quitting": false, "quit_requested": false}},
  {"call": "app.quit"},
  {"widget": "Don't Save"},
  {"expect": {"quit_requested": true}}
]

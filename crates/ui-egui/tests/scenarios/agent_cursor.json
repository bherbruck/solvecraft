  {"queued": "engine.execute", "params": {"command": "sketch.finish", "params": {}}, "min_frames": 30},
  {"queued": "engine.execute", "params": {"command": "solid.extrude", "params": {"distance": 10, "operation": "new"}}, "min_frames": 30},
  {"expect": {"errors": 0, "bodies": 1, "volume": [10000, 1e-6]}},

{
  "format": "solidcraft/11",
  "name": "HardEdgeBasin",
  "units": "mm",
  "params": [
    {
      "name": "basin_width",
      "expr": "room_width - 2 * side_gap",
      "unit": "mm",
      "comment": "Derived from room width",
      "model": false
    },
    {
      "name": "basin_depth",
      "expr": "480 mm",
      "unit": "mm",
      "comment": "Projection from back wall (DIN: 450-500)",
      "model": false
    },
    {
      "name": "basin_height",
      "expr": "160 mm",
      "unit": "mm",
      "comment": "Outer slab height",
      "model": false
    },
    {
      "name": "mount_height",
      "expr": "850 mm",
      "unit": "mm",
      "comment": "Top edge above finished floor (DIN 18022: 850-900)",
      "model": false
    },
    {
      "name": "left_rim",
      "expr": "150 mm",
      "unit": "mm",
      "comment": "Left shelf width (soap dispenser)",
      "model": false
    },
    {
      "name": "front_rim",
      "expr": "18 mm",
      "unit": "mm",
      "comment": "Front rim width",
      "model": false
    },
    {
      "name": "back_rim",
      "expr": "30 mm",
      "unit": "mm",
      "comment": "Back rim width (faucet moved to side shelf)",
      "model": false
    },
    {
      "name": "bowl_depth",
      "expr": "120 mm",
      "unit": "mm",
      "comment": "Bowl depth at walls, from top edge",
      "model": false
    },
    {
      "name": "floor_drop",
      "expr": "4 mm",
      "unit": "mm",
      "comment": "Fall from trough edges to drain seat",
      "model": false
    },
    {
      "name": "drain_dia",
      "expr": "45 mm",
      "unit": "mm",
      "comment": "Waste outlet 1 1/4 in",
      "model": false
    },
    {
      "name": "tap_hole_dia",
      "expr": "35 mm",
      "unit": "mm",
      "comment": "Standard tap hole",
      "model": false
    },
    {
      "name": "d2",
      "expr": "basin_width",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d3",
      "expr": "basin_depth",
      "unit": "mm",
      "model": true
    },
    {
      "name": "room_width",
      "expr": "906 mm",
      "unit": "mm",
      "comment": "Measured wall-to-wall width",
      "model": false
    },
    {
      "name": "side_gap",
      "expr": "3 mm",
      "unit": "mm",
      "comment": "Silicone joint per side",
      "model": false
    },
    {
      "name": "side_wall_angle",
      "expr": "10 deg",
      "unit": "deg",
      "comment": "Side walls, from vertical",
      "model": false
    },
    {
      "name": "back_wall_angle",
      "expr": "10 deg",
      "unit": "deg",
      "comment": "Back wall, from vertical",
      "model": false
    },
    {
      "name": "trough_length",
      "expr": "100 mm",
      "unit": "mm",
      "comment": "Flat bottom strip front-to-back",
      "model": false
    },
    {
      "name": "side_run",
      "expr": "bowl_depth * tan(side_wall_angle)",
      "unit": "mm",
      "comment": "Derived",
      "model": false
    },
    {
      "name": "back_run",
      "expr": "bowl_depth * tan(back_wall_angle)",
      "unit": "mm",
      "comment": "Derived",
      "model": false
    },
    {
      "name": "d6",
      "expr": "left_rim",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d7",
      "expr": "back_rim",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d8",
      "expr": "bowl_width",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d9",
      "expr": "basin_depth - back_rim - front_rim",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d11",
      "expr": "left_rim + side_run",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d12",
      "expr": "back_rim + back_run",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d13",
      "expr": "bowl_width - 2 * side_run",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d14",
      "expr": "trough_length",
      "unit": "mm",
      "model": true
    },
    {
      "name": "drain_seat",
      "expr": "80 mm",
      "unit": "mm",
      "comment": "Flat square seat for waste flange (66 mm cap)",
      "model": false
    },
    {
      "name": "wall_thickness",
      "expr": "20 mm",
      "unit": "mm",
      "comment": "GFRC wall thickness",
      "model": false
    },
    {
      "name": "drain_x",
      "expr": "left_rim + bowl_width / 2",
      "unit": "mm",
      "comment": "Drain centre X",
      "model": false
    },
    {
      "name": "drain_y",
      "expr": "-(back_rim + back_run + trough_length / 2)",
      "unit": "mm",
      "comment": "Drain centre Y (wall at 0)",
      "model": false
    },
    {
      "name": "seat_z",
      "expr": "mount_height - bowl_depth - floor_drop",
      "unit": "mm",
      "comment": "Drain seat height",
      "model": false
    },
    {
      "name": "d16",
      "expr": "drain_x - drain_seat / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d17",
      "expr": "-drain_y - drain_seat / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d18",
      "expr": "drain_seat",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d19",
      "expr": "drain_seat",
      "unit": "mm",
      "model": true
    },
    {
      "name": "fall_inset",
      "expr": "0 mm",
      "unit": "mm",
      "comment": "Fall starts this far inside trough edge (kernel workaround)",
      "model": false
    },
    {
      "name": "d21",
      "expr": "left_rim + side_run + fall_inset",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d22",
      "expr": "back_rim + back_run + fall_inset",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d23",
      "expr": "bowl_width - 2 * (side_run + fall_inset)",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d24",
      "expr": "trough_length - 2 * fall_inset",
      "unit": "mm",
      "model": true
    },
    {
      "name": "drain_boss_dia",
      "expr": "90 mm",
      "unit": "mm",
      "comment": "Thickened pad under drain (must stay < trough_length)",
      "model": false
    },
    {
      "name": "drain_boss_height",
      "expr": "12 mm",
      "unit": "mm",
      "comment": "Pad height below seat underside",
      "model": false
    },
    {
      "name": "d27",
      "expr": "drain_x",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d28",
      "expr": "-drain_y",
      "unit": "mm",
      "model": true

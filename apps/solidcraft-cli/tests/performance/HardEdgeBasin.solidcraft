    {
      "name": "d84",
      "expr": "tap_x",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d85",
      "expr": "-tap_y",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d86",
      "expr": "48 mm",
      "unit": "mm",
      "model": true
    },
    {
      "name": "cut_clear",
      "expr": "1 mm",
      "unit": "mm",
      "comment": "Kernel workaround: keeps cut faces off existing faces",
      "model": false
    },
    {
      "name": "ramp_run",
      "expr": "basin_depth - front_rim - back_rim - back_run - trough_length",
      "unit": "mm",
      "comment": "Derived: horizontal length of front ramp",
      "model": false
    },
    {
      "name": "ramp_off",
      "expr": "wall_thickness * sqrt(bowl_depth^2 + ramp_run^2) / bowl_depth",
      "unit": "mm",
      "comment": "Derived: horizontal offset of ramp underside",
      "model": false
    },
    {
      "name": "side_off",
      "expr": "wall_thickness / cos(side_wall_angle)",
      "unit": "mm",
      "comment": "Derived",
      "model": false
    },
    {
      "name": "back_off",
      "expr": "wall_thickness / cos(back_wall_angle)",
      "unit": "mm",
      "comment": "Derived",
      "model": false
    },
    {
      "name": "d97",
      "expr": "left_rim + (bowl_depth + wall_thickness) * tan(side_wall_angle) - side_off",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d98",
      "expr": "back_rim + (bowl_depth + wall_thickness) * tan(back_wall_angle) - back_off",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d99",
      "expr": "bowl_width - 2 * ((bowl_depth + wall_thickness) * tan(side_wall_angle) - side_off)",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d100",
      "expr": "(basin_depth - front_rim) - (bowl_depth + wall_thickness) * ramp_run / bowl_depth + ramp_off - (back_rim + (bowl_depth + wall_thickness) * tan(back_wall_angle) - back_off)",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d102",
      "expr": "left_rim - side_off",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d103",
      "expr": "back_rim - back_off",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d104",
      "expr": "bowl_width + 2 * side_off",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d105",
      "expr": "basin_depth - front_rim + ramp_off - back_rim + back_off",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d107",
      "expr": "5 mm",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d108",
      "expr": "wall_thickness",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d109",
      "expr": "basin_width + 10 mm",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d110",
      "expr": "basin_depth - 2 * wall_thickness",
      "unit": "mm",
      "model": true
    },
    {
      "name": "faucet_body_h",
      "expr": "105 mm",
      "unit": "mm",
      "comment": "Faucet body height (option B)",
      "model": false
    },
    {
      "name": "ledger_size",
      "expr": "40 mm",
      "unit": "mm",
      "comment": "Steel angle leg length",
      "model": false
    },
    {
      "name": "ledger_t",
      "expr": "4 mm",
      "unit": "mm",
      "comment": "Steel angle thickness",
      "model": false
    },
    {
      "name": "ledger_len",
      "expr": "basin_depth - 2 * wall_thickness - 10 mm",
      "unit": "mm",
      "comment": "Fits between front and back skirt",
      "model": false
    },
    {
      "name": "d113",
      "expr": "side_gap",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d114",
      "expr": "mount_height - wall_thickness",
      "unit": "mm",
      "model": true
    },

      "model": false
    },
    {
      "name": "faucet_outlet_h",
      "expr": "170 mm",
      "unit": "mm",
      "comment": "Outlet height above deck (option B)",
      "model": false
    },
    {
      "name": "faucet_top_h",
      "expr": "218 mm",
      "unit": "mm",
      "comment": "Spout centreline top above deck (230 to top of Ø24 tube)",
      "model": false
    },
    {
      "name": "d79",
      "expr": "tap_x",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d80",
      "expr": "-tap_y",
      "unit": "mm",

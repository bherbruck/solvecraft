    {
      "name": "d126",
      "expr": "ledger_t",
      "unit": "mm",
      "model": true
    },
    {
      "name": "spout_tip_angle",
      "expr": "30 deg",
      "unit": "deg",
      "comment": "Outlet tilt from vertical, away from body (estimated from photo)",
      "model": false
    },
    {
      "name": "spout_bend_r",
      "expr": "50 mm",
      "unit": "mm",
      "comment": "Top bend radius (centreline)",
      "model": false
    },
    {
      "name": "spout_tip_r",
      "expr": "35 mm",
      "unit": "mm",
      "comment": "Front bend radius (centreline)",
      "model": false
    },
    {
      "name": "d89",
      "expr": "spout_bend_r",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d90",
      "expr": "spout_tip_r",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d91",
      "expr": "tap_x",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d92",
      "expr": "mount_height + faucet_body_h",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d93",
      "expr": "mount_height + faucet_top_h",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d94",
      "expr": "faucet_reach",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d95",
      "expr": "mount_height + faucet_outlet_h",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d128",
      "expr": "90 deg - spout_tip_angle",
      "unit": "deg",
      "model": true
    },
    {
      "name": "water_speed",
      "expr": "800",
      "unit": "",
      "comment": "Stream exit speed, mm/s (aerated basin tap ~ 500-1000)",
      "model": false
    },
    {
      "name": "stream_fall",
      "expr": "(faucet_outlet_h + bowl_depth) / (1 mm)",
      "unit": "",
      "comment": "Derived: fall height to bottom strip, mm (unitless)",
      "model": false
    },
    {
      "name": "stream_t",
      "expr": "(-water_speed * cos(spout_tip_angle) + sqrt((water_speed * cos(spout_tip_angle))^2 + 2 * 9810 * stream_fall)) / 9810",
      "unit": "",
      "comment": "Derived: fall time, s",
      "model": false
    },
    {
      "name": "stream_throw",
      "expr": "water_speed * sin(spout_tip_angle) * stream_t * 1 mm",
      "unit": "mm",
      "comment": "Derived: extra horizontal throw from angled outlet",
      "model": false
    },
    {
      "name": "d130",
      "expr": "tap_x - faucet_reach - stream_throw",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d131",
      "expr": "mount_height - bowl_depth",
      "unit": "mm",
      "model": true
    },
    {
      "name": "edge_fillet",
      "expr": "3 mm",
      "unit": "mm",
      "comment": "Radius of the bowl rim and front top/bottom fillets",
      "model": false
    },
    {
      "name": "bowl_corner_r",
      "expr": "15 mm",
      "unit": "mm",
      "comment": "Inside corners of the bowl: wall-wall and wall-floor (cleaning, mould release)",
      "model": false
    },
    {
      "name": "drain_edge_r",
      "expr": "2 mm",
      "unit": "mm",
      "comment": "Round on the drain hole rim (seat side)",
      "model": false
    }
  ],
  "features": [
    {
      "id": 1,

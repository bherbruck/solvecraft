    {
      "name": "waste_len",
      "expr": "58 mm",
      "unit": "mm",
      "comment": "Waste valve body length (product)",
      "model": false
    },
    {
      "name": "tail_len",
      "expr": "58 mm",
      "unit": "mm",
      "comment": "Waste tailpiece length (product)",
      "model": false
    },
    {
      "name": "trap_height",
      "expr": "195 mm",
      "unit": "mm",
      "comment": "Bottle trap overall height (150-230), set for wall outlet at 500 mm",
      "model": false
    },
    {
      "name": "trap_outlet_z",
      "expr": "seat_z - waste_len - tail_len - trap_height + 85 mm",
      "unit": "mm",
      "comment": "Trap outlet centre height = wall waste connection height",
      "model": false
    },
    {
      "name": "right_rim",
      "expr": "150 mm",
      "unit": "mm",
      "comment": "Right shelf width (faucet)",
      "model": false
    },
    {
      "name": "bowl_width",
      "expr": "basin_width - left_rim - right_rim",
